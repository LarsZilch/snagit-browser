<Window x:Class="SnagitBrowser.App.BulkTagWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tags bearbeiten" Icon="pack://application:,,,/SnagitBrowser.App;component/app.ico" Width="560" Height="600" MinWidth="420" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="13" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary Source="Styles.xaml" />
    </Window.Resources>

    <DockPanel Margin="14">
        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />

        <!-- Fußzeile: Zusammenfassung + Übernehmen/Abbrechen -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Click="Cancel_Click" Margin="0" ToolTip="Nichts ändern (Esc)">
                <TextBlock Text="Abbrechen" />
            </Button>
            <Button x:Name="ApplyButton" DockPanel.Dock="Right" Click="Apply_Click" BorderBrush="#1E88E5"
                    ToolTip="Tags in alle ausgewählten .snagx-Dateien schreiben (Strg+Enter)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" Foreground="#1565C0" />
                    <TextBlock Text="Übernehmen" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="Tags der Auswahl" Style="{StaticResource Heading}" />
        <TextBlock DockPanel.Dock="Top" Foreground="#777" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap"
                   Text="Hellblau mit Zahl = nur bei einem Teil der Bilder vorhanden. Klick auf den Namen setzt ihn bei allen, × entfernt ihn bei allen." />
        <ItemsControl x:Name="TagList" DockPanel.Dock="Top" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Chip" Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1" CornerRadius="12"
                            Padding="10,3,4,3" Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal">
                            <Button Click="ChipName_Click" Tag="{Binding Name}" Padding="0" Margin="0" Background="Transparent"
                                    BorderBrush="Transparent" ToolTip="Bei allen ausgewählten Bildern setzen">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8EC;" FontSize="11" Foreground="#1565C0"
                                               VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="{Binding Name}" Foreground="#0D47A1" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CountText}" Foreground="#5C7FA8" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Click="ChipRemove_Click" Tag="{Binding Name}" ToolTip="Bei allen ausgewählten Bildern entfernen"
                                    Padding="4,1" Margin="5,0,0,0" Background="Transparent" BorderBrush="Transparent">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="9" Foreground="#1565C0" />
                            </Button>
                        </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsPartial}" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="#F5FAFF" />
                            <Setter TargetName="Chip" Property="BorderBrush" Value="#BBDEFB" />
                            <Setter TargetName="Chip" Property="BorderThickness" Value="1" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="NoTagsText" DockPanel.Dock="Top" Text="Keine Tags vergeben" Foreground="#999" FontStyle="Italic" Margin="0,0,0,6" />

        <DockPanel DockPanel.Dock="Top" Margin="0,6,0,6">
            <Button DockPanel.Dock="Right" Click="AddTag_Click" Margin="6,0,0,0" ToolTip="Tag bei allen hinzufügen (Enter)">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" /><TextBlock Text="Hinzufügen" /></StackPanel>
            </Button>
            <Grid>
                <TextBox x:Name="NewTagBox" Padding="4,3" VerticalContentAlignment="Center"
                         TextChanged="NewTagBox_TextChanged" KeyDown="NewTagBox_KeyDown"
                         ToolTip="Neuen Tag eingeben oder vorhandene Tags filtern; Enter fügt hinzu" />
                <TextBlock x:Name="NewTagPlaceholder" Text="Neuer Tag oder suchen …" Foreground="#999" Margin="7,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Foreground="#666" Margin="0,2,0,4" FontSize="12"
                   Text="Vorhandene Tags – Klick setzt bzw. entfernt bei allen ausgewählten Bildern:" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <ItemsControl x:Name="AllTagsList" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton x:Name="Btn" Content="{Binding Name}" IsChecked="{Binding IsAll, Mode=OneWay}" Tag="{Binding Name}"
                                      Click="TagChoice_Click" Padding="8,2" Margin="0,0,4,4" FontSize="12" />
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsPartial}" Value="True">
                                <Setter TargetName="Btn" Property="Background" Value="#EEF6FD" />
                                <Setter TargetName="Btn" Property="BorderBrush" Value="#90CAF9" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
