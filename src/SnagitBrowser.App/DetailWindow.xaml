<Window x:Class="SnagitBrowser.App.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SnagitBrowser.App"
        Title="Capture" Icon="pack://application:,,,/SnagitBrowser.App;component/app.ico" Height="850" Width="1300" WindowStartupLocation="CenterOwner" FontSize="13"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary Source="Styles.xaml" />
    </Window.Resources>

    <DockPanel>
        <!-- Button-Leiste -->
        <Border DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="8,6">
            <WrapPanel>
                <Button x:Name="PrevButton" Click="Prev_Click" ToolTip="{local:L Detail_Prev_Tip}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" /><TextBlock Text="{local:L Detail_Prev}" /></StackPanel>
                </Button>
                <Button x:Name="NextButton" Click="Next_Click" ToolTip="{local:L Detail_Next_Tip}" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{local:L Detail_Next}" /><TextBlock Style="{StaticResource Icon}" Text="&#xE72A;" Margin="6,0,0,0" /></StackPanel>
                </Button>

                <ToggleButton x:Name="OriginalToggle" Click="OriginalToggle_Click" ToolTip="{local:L Detail_Original_Tip}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE91B;" /><TextBlock Text="{local:L Detail_Original}" /></StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="FitToggle" IsChecked="True" Click="FitToggle_Click" ToolTip="{local:L Detail_Fit_Tip}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE9A6;" /><TextBlock Text="{local:L Detail_Fit}" /></StackPanel>
                </ToggleButton>
                <Button Click="ZoomOut_Click" ToolTip="{local:L Detail_ZoomOut_Tip}" Padding="8,5">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71F;" Margin="0" />
                </Button>
                <TextBlock x:Name="ZoomText" Text="100 %" VerticalAlignment="Center" MinWidth="44" TextAlignment="Center"
                           Margin="0,0,6,0" Foreground="#444" />
                <Button Click="ZoomIn_Click" ToolTip="{local:L Detail_ZoomIn_Tip}" Padding="8,5" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A3;" Margin="0" />
                </Button>

                <Button Click="OpenInSnagit_Click" ToolTip="{local:L Detail_OpenInSnagit_Tip}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" /><TextBlock Text="{local:L Detail_OpenInSnagit}" /></StackPanel>
                </Button>
                <Button Click="SaveImage_Click" ToolTip="{local:L Detail_SaveImage_Tip}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" /><TextBlock Text="{local:L Detail_SaveImage}" /></StackPanel>
                </Button>
                <Button Click="CopyImage_Click" ToolTip="{local:L Detail_CopyImage_Tip}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" /><TextBlock Text="{local:L Detail_CopyImage}" /></StackPanel>
                </Button>
                <Button Click="CopyText_Click" ToolTip="{local:L Detail_CopyTexts_Tip}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8D2;" /><TextBlock Text="{local:L Common_CopyTexts}" /></StackPanel>
                </Button>
                <Button Click="Explorer_Click" ToolTip="{local:L Detail_Explorer_Tip}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE838;" /><TextBlock Text="{local:L Common_ShowInExplorer}" /></StackPanel>
                </Button>
                <Button Click="Delete_Click" ToolTip="{local:L Detail_Delete_Tip}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Foreground="#C62828" /><TextBlock Text="{local:L Common_Delete}" /></StackPanel>
                </Button>
            </WrapPanel>
        </Border>
        <Border x:Name="HintBar" DockPanel.Dock="Top" Background="#FFF8E1" BorderBrush="#F0D88A" BorderThickness="0,0,0,1" Padding="10,4">
            <TextBlock x:Name="HintText" TextWrapping="Wrap" Foreground="#6D5300" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Mausrad: blättern · Strg+Mausrad: zoomen · Ziehen: verschieben · Doppelklick: Einpassen/100 % -->
            <ScrollViewer x:Name="ImageScroll" Background="#2B2B2B" Focusable="False"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="ImageScroll_PreviewMouseWheel"
                          PreviewMouseLeftButtonDown="ImageScroll_MouseLeftButtonDown"
                          PreviewMouseMove="ImageScroll_MouseMove"
                          PreviewMouseLeftButtonUp="ImageScroll_MouseLeftButtonUp">
                <Image x:Name="ImageView" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                       SizeChanged="ImageView_SizeChanged" />
            </ScrollViewer>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#DDD" Focusable="False" />

            <DockPanel Grid.Column="2" Margin="12,10,10,10">
                <!-- Tags ganz oben als Kacheln; Klick auf × entfernt den Tag -->
                <TextBlock DockPanel.Dock="Top" Text="{local:L Detail_Tags}" Style="{StaticResource Heading}" />
                <ItemsControl x:Name="TagList" DockPanel.Dock="Top" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1" CornerRadius="12"
                                    Padding="10,3,4,3" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8EC;" FontSize="11" Foreground="#1565C0"
                                               VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="{Binding}" Foreground="#0D47A1" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Click="RemoveTag_Click" Tag="{Binding}" ToolTip="{local:L Detail_RemoveTag_Tip}" Padding="4,1" Margin="5,0,0,0"
                                            Background="Transparent" BorderBrush="Transparent">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="9" Foreground="#1565C0" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="NoTagsText" DockPanel.Dock="Top" Text="{local:L Tags_None}" Foreground="#999"
                           FontStyle="Italic" Margin="0,0,0,6" />

                <!-- Speichern / Verwerfen erscheinen nur bei ungespeicherten Änderungen -->
                <Border x:Name="TagSaveBar" DockPanel.Dock="Top" Background="#FFF8E1" BorderBrush="#F0D88A" BorderThickness="1"
                        CornerRadius="5" Padding="8,6" Margin="0,0,0,8" Visibility="Collapsed">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Click="DiscardTags_Click" Margin="0" ToolTip="{local:L Detail_Discard_Tip}">
                            <TextBlock Text="{local:L Detail_Discard}" />
                        </Button>
                        <Button DockPanel.Dock="Right" Click="SaveTags_Click" BorderBrush="#1E88E5"
                                ToolTip="{local:L Detail_Save_Tip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" Foreground="#1565C0" />
                                <TextBlock Text="{local:L Detail_Save}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{local:L Detail_TagsChanged}" VerticalAlignment="Center" Foreground="#6D5300" />
                    </DockPanel>
                </Border>

                <!-- Neuer Tag / Filter für die vorhandenen Tags -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Click="AddTag_Click" Margin="6,0,0,0" ToolTip="{local:L Detail_Add_Tip}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" /><TextBlock Text="{local:L Common_Add}" /></StackPanel>
                    </Button>
                    <Grid>
                        <TextBox x:Name="NewTagBox" Padding="4,3" VerticalContentAlignment="Center"
                                 TextChanged="NewTagBox_TextChanged" KeyDown="NewTagBox_KeyDown"
                                 ToolTip="{local:L Tags_NewTag_Tip}" />
                        <TextBlock Text="{local:L Tags_NewTag_Placeholder}" Foreground="#999" Margin="7,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" x:Name="NewTagPlaceholder" />
                    </Grid>
                </DockPanel>

                <TextBlock DockPanel.Dock="Top" Foreground="#666" Margin="0,2,0,4" FontSize="12"
                           Text="{local:L Detail_ExistingTags}" />
                <ScrollViewer DockPanel.Dock="Top" MaxHeight="170" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl x:Name="AllTagsList" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Content="{Binding Name}" IsChecked="{Binding IsAssigned, Mode=OneWay}" Tag="{Binding Name}"
                                              Click="TagChoice_Click" Padding="8,2" Margin="0,0,4,4" FontSize="12" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock DockPanel.Dock="Top" Text="{local:L Detail_Metadata}" Style="{StaticResource Heading}" Margin="0,12,0,6" />
                <ItemsControl x:Name="MetaList" DockPanel.Dock="Top" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="105" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Key}" Foreground="#666" />
                                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True"
                                         BorderThickness="0" Background="Transparent" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock DockPanel.Dock="Top" Text="{local:L Detail_Texts}" Style="{StaticResource Heading}" Margin="0,14,0,6" />
                <TextBox x:Name="TextsBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         AcceptsReturn="True" FontSize="14" Padding="4" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
